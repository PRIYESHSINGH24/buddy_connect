generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & connections ─────────────────────────────────────────────
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String    @default("") // bcrypt hash (empty for OAuth users)
  name               String
  username           String?   @unique
  college            String    @default("")
  department         String    @default("")
  year               String    @default("")
  skills             String[]  @default([])
  bio                String    @default("")
  profileImage       String?
  linkedinUrl        String?
  socials            Json?
  interests          String[]  @default([])
  connections        String[]  @default([]) // accepted connection user ids
  incomingRequests   String[]  @default([]) // user ids that requested me
  outgoingRequests   String[]  @default([]) // user ids I requested
  featuredProjectIds String[]  @default([])
  endorsements       Json?
  experience         Json?
  education          Json?
  projects           Json?
  certifications     Json?
  contact            Json?
  resumeUrl          String?
  emailVerified      Boolean   @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  posts             Post[]
  comments          Comment[]
  projectsCreated   Project[]
  eventsOrganized   CollegeEvent[]
  jobsCreated       Job[]
  notificationsGot  Notification[]  @relation("NotifRecipient")
  notificationsSent Notification[]  @relation("NotifSender")
  messagesSent      Message[]       @relation("MsgFrom")
  messagesReceived  Message[]       @relation("MsgTo")

  @@index([createdAt])
  @@index([name]) // users list: ORDER BY name + cursor pagination
}

// ─── Feed ────────────────────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  userId      String
  author      String
  authorImage String?
  content     String
  image       String?
  attachments Json? // PostAttachment[]: { name, type, size, url?, data? }
  likes       String[] @default([]) // user ids
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  author    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

// ─── Projects ────────────────────────────────────────────────────────
model Project {
  id           String   @id @default(cuid())
  userId       String
  author       String
  title        String
  description  String
  githubUrl    String
  technologies String[] @default([])
  image        String?
  likes        String[] @default([]) // user ids
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Events ──────────────────────────────────────────────────────────
model CollegeEvent {
  id               String   @id @default(cuid())
  title            String
  description      String
  date             DateTime
  time             String
  location         String
  organizer        String // user id
  attendees        String[] @default([]) // user ids
  category         String
  image            String?
  registrationOpen Boolean  @default(true)
  maxAttendees     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organizerUser User @relation(fields: [organizer], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([category])
  @@index([date, category])
}

// ─── Jobs ────────────────────────────────────────────────────────────
model Job {
  id             String   @id @default(cuid())
  companyId      String?
  companyName    String
  title          String
  description    String
  location       String?
  employmentType String?
  salaryRange    String?
  hiringBatch    String?
  applyLink      String?
  applicants     String[] @default([]) // user ids
  createdBy      String // user id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
}

// ─── Hackathons ──────────────────────────────────────────────────────
model Hackathon {
  id                   String   @id @default(cuid())
  title                String
  description          String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  theme                String
  image                String?
  prizes               String[] @default([])
  organizer            String // user id
  teams                String[] @default([]) // HackathonTeam ids
  createdAt            DateTime @default(now())
}

model HackathonTeam {
  id          String   @id @default(cuid())
  hackathonId String
  name        String
  teamLead    String // user id
  members     String[] @default([]) // user ids
  skills      String[] @default([])
  idea        String?
  createdAt   DateTime @default(now())

  @@index([hackathonId])
}

// ─── Notifications ───────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  recipient String // user id
  sender    String? // user id
  type      String
  message   String
  jobId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  recipientUser User  @relation("NotifRecipient", fields: [recipient], references: [id], onDelete: Cascade)
  senderUser    User? @relation("NotifSender", fields: [sender], references: [id], onDelete: SetNull)

  @@index([recipient, createdAt(sort: Desc)])
  @@index([read])
}

// ─── Messages ────────────────────────────────────────────────────────
model Message {
  id      String @id @default(cuid())
  from    String // user id
  to      String // user id
  content String
  readAt  DateTime?
  createdAt DateTime @default(now())

  fromUser User @relation("MsgFrom", fields: [from], references: [id], onDelete: Cascade)
  toUser   User @relation("MsgTo", fields: [to], references: [id], onDelete: Cascade)

  @@index([from, to, createdAt(sort: Desc)])
  @@index([to, from, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
